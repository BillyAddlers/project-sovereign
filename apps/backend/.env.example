# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection string used by both the Prisma CLI and the driver adapter.
# Must match the container started by `bun run db:up` (see README) — database
# name, user, password, and published port all have to agree.
DATABASE_URL="postgresql://admin:password@localhost:5432/project_sovereign?schema=public"

# HTTP port for the Hono server.
PORT=3001

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# development | test | production
NODE_ENV=development

# debug | info | warn | error | fatal | silent
LOG_LEVEL=info
